# .env is better suited for public variables, ie, variables that should not commited
# For secret variables is better to use DevServerControl tool with set_env_variable: ["KEY", "SECRET"]

# https://www.builder.io/c/docs/using-your-api-key
VITE_PUBLIC_BUILDER_KEY=__BUILDER_PUBLIC_KEY__
PING_MESSAGE="ping pong"

# ── Financial Data API Keys ──────────────────────────────────────────────────
# All keys are read server-side only. Never expose them in client code.

# FMP_KEY: Financial Modeling Prep — financial statements, ratios, key metrics, earnings
# Free tier: 250 req/day. Sign up at https://financialmodelingprep.com
FMP_KEY=YOUR_FMP_API_KEY

# AV_KEY: Alpha Vantage — stock quotes, overview, time series
# Free tier: 25 req/day. Sign up at https://www.alphavantage.co
AV_KEY=YOUR_ALPHAVANTAGE_API_KEY

# FINNHUB_KEY: Finnhub — company news, insider transactions
# Free tier: 60 req/min. Sign up at https://finnhub.io
FINNHUB_KEY=YOUR_FINNHUB_API_KEY

# Logo.dev key for company logo proxy route (/api/company-logo)
# Can be publishable pk_ key or account key. Sign up at https://logo.dev
LOGO_DEV_TOKEN=pk_YOUR_LOGO_DEV_KEY

# ── Data Source Strategy ─────────────────────────────────────────────────────
# Yahoo Finance (yahoo-finance2 npm) — FREE, unlimited, no key needed.
#   Used for: real-time quotes, price history, profiles, analyst estimates
# FMP — 250 req/day free tier.
#   Used for: financial statements, ratios, key metrics, insider trades, earnings
# Alpha Vantage — 25 req/day free tier.
#   Used for: fallback quotes, overview data
# Finnhub — 60 req/min free tier.
#   Used for: company news
# Logo.dev — free tier with pk_ key.
#   Used for: company logos
