# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies and build output
node_modules
dist
dist-ssr
*.local
.vercel

# Local application state
.freebuff/

# AI tooling / agent config (never pushed — not part of the app)
.agents/
.builder/
.claude/
.codex/
.dev-port/
.backup/
# Agent runtime lockfiles — regenerated per session by codebuff/freebuff,
# never reproducible from a clean checkout. Keeping them out of git status
# removes noise from every `git status` after an agent run.
skills-lock.json
# Per-instance Vercel preview-link overrides. `.vercel/` is already
# excluded, but `.vercel/*.local` is explicit so a future operator can
# `git add -f .vercel/<file>` without accidentally committing their local
# token overrides.
.vercel/*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local configuration and secrets
.config/
.env
.env.local
.env.*.local
.env*
